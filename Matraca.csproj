<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Matraca</AssemblyName>
    <RootNamespace>Matraca</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Metadados do executavel: aparecem no Explorer e sao exigidos pelo SignPath
       (file metadata attributes) na assinatura de release. -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Product>Matraca</Product>
    <Company>Fabricio Casali</Company>
    <Authors>Fabricio Casali</Authors>
    <Description>Ditado por voz (speech-to-text) para Windows, com Whisper local.</Description>
    <Copyright>Copyright (c) Fabricio Casali</Copyright>
    <PackageProjectUrl>https://github.com/FabricioCasali/matraca</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FabricioCasali/matraca</RepositoryUrl>
  </PropertyGroup>

  <!-- O spike do macOS (spike/mac/) fica DENTRO da pasta deste projeto, e o glob padrao do
       SDK varre **/*.cs a partir daqui. Sem esta exclusao o Matraca.csproj compila junto
       os fontes do spike E o obj/ dele, e o build do Windows quebra com oito CS0579
       ("Duplicar atributo AssemblyTitle/AssemblyVersion/..."), porque cada projeto gera o
       proprio AssemblyInfo.cs. Os globs padrao so' excluem o bin/ e o obj/ DESTE projeto,
       nunca os de um projeto aninhado. Sai junto com spike/ na Fase 2. -->
  <ItemGroup>
    <Compile Remove="spike/**" />
    <None Remove="spike/**" />
    <EmbeddedResource Remove="spike/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.39.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="app.ico;rec.ico;busy.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
