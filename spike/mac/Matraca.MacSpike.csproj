<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- net8.0 PURO, sem traco no TFM. Nao e' descuido: a regra de copia do
         Whisper.net.Runtime.targets e'
           Condition="$(TargetFramework.Contains('-macos')) == true
                      or $(TargetFramework.Contains('-')) == false"
         ou seja, um TFM sem traco recebe as dylibs de macOS em runtimes/macos-arm64/,
         libggml-metal-whisper.dylib inclusa, sem workload nenhum.
         net8.0-macos exigiria o workload 'macos', que traz o modelo de binding estilo
         Xamarin.Mac (o oposto do interop manual que este spike existe pra provar) e
         tira de nos o controle da montagem do .app — que e' o item de maior valor da
         Fase 0. Efeito colateral aceito: a mesma condicao vale p/ Linux, entao a saida
         ganha runtimes/linux-*/ de brinde. Ruido; nao limpar agora. -->
    <TargetFramework>net8.0</TargetFramework>

    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Matraca</AssemblyName>
    <RootNamespace>Matraca.MacSpike</RootNamespace>

    <!-- [UnmanagedCallersOnly] + delegate* sao o padrao de callback deste spike. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- PublishSingleFile e' PROIBIDO aqui, e o motivo precisa ficar escrito:
         o single-file extrai o conteudo p/ um diretorio temporario em runtime, e com
         isso (a) quebra a sondagem de runtimes/macos-arm64 que o NativeLibraryLoader do
         Whisper.net faz relativa ao AppContext.BaseDirectory, e (b) muda o caminho do
         executavel, que e' de onde o TCC deriva a identidade guardada da concessao de
         Acessibilidade. Nao ligar "so pra testar". -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesmas versoes do Matraca.csproj. Divergir versao entre os dois lados e' como se
         cria um bug que so' aparece num sistema. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- Nao traz dylib: so' o shader ggml-metal.metal, copiado p/ a raiz da saida.
         Seguro barato. -->
    <PackageReference Include="Whisper.net.Runtime.Metal" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Hud/hud.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>hud.html</Link>
    </None>
  </ItemGroup>

</Project>
