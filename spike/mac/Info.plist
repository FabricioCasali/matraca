<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>io.github.fabriciocasali.matraca</string>
  <key>CFBundleName</key>
  <string>Matraca</string>
  <key>CFBundleExecutable</key>
  <string>Matraca</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.0.0</string>
  <key>CFBundleVersion</key>
  <string>0</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>

  <!-- App de bandeja: sem icone no Dock, sem menu bar propria. -->
  <key>LSUIElement</key>
  <true/>

  <!-- NAO E' OPCIONAL. Sem esta chave o processo e' MORTO (SIGKILL) pelo sistema no
       instante em que pede acesso ao microfone — nao e' permissao negada com erro
       tratavel. Nao existe chave equivalente para Acessibilidade: aquela e' concedida
       a mao em Ajustes do Sistema -> Privacidade e Seguranca -> Acessibilidade. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>O Matraca usa o microfone para transcrever sua fala localmente, na sua máquina.</string>
</dict>
</plist>
