<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Matraca</AssemblyName>
    <RootNamespace>Matraca</RootNamespace>
    <MatracaApplicationManifest Condition="'$(MatracaApplicationManifest)' == ''">app.manifest</MatracaApplicationManifest>
    <ApplicationManifest>$(MatracaApplicationManifest)</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Metadados do executavel: aparecem no Explorer e sao exigidos pelo SignPath
       (file metadata attributes) na assinatura de release. -->
  <PropertyGroup>
    <Version>2.0.1</Version>
    <Product>Matraca</Product>
    <Company>Fabricio Casali</Company>
    <Authors>Fabricio Casali</Authors>
    <Description>Ditado por voz (speech-to-text) para Windows, com Whisper local.</Description>
    <Copyright>Copyright (c) Fabricio Casali</Copyright>
    <PackageProjectUrl>https://github.com/FabricioCasali/matraca</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FabricioCasali/matraca</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3405.78" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../Matraca.Web/wwwroot/**/*">
      <Link>Web/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../design/assets/brand/*.svg">
      <Link>Web/assets/brand/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="app.ico;Icons/**/*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Matraca.Core/Matraca.Core.csproj" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2DesktopReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

</Project>
