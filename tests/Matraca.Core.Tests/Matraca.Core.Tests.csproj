<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Matraca.Core/Matraca.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Matraca.Mac/Platform/Audio/MacAudioDevice.cs"
             Link="Compatibility/MacAudioDevice.cs" />
    <Compile Include="../../Matraca.Mac/Platform/Audio/MacAudioDeviceSelector.cs"
             Link="Compatibility/MacAudioDeviceSelector.cs" />
    <Compile Include="../../Matraca.Mac/Platform/Audio/MacSoundWave.cs"
             Link="Compatibility/MacSoundWave.cs" />
    <Compile Include="../../Matraca.Mac/Platform/Text/IPasteboard.cs"
             Link="Compatibility/IPasteboard.cs" />
    <Compile Include="../../Matraca.Mac/Platform/Text/PasteboardItemSnapshot.cs"
             Link="Compatibility/PasteboardItemSnapshot.cs" />
    <Compile Include="../../Matraca.Mac/Platform/Text/PasteboardRestoreResult.cs"
             Link="Compatibility/PasteboardRestoreResult.cs" />
    <Compile Include="../../Matraca.Mac/Platform/Text/PasteboardSnapshot.cs"
             Link="Compatibility/PasteboardSnapshot.cs" />
    <Compile Include="../../Matraca.Mac/Platform/Text/PasteboardTransaction.cs"
             Link="Compatibility/PasteboardTransaction.cs" />
    <Compile Include="../../Matraca.Windows/WindowsHotkeyTranslator.cs"
             Link="Compatibility/WindowsHotkeyTranslator.cs" />
    <None Include="../../Matraca.Windows/appsettings.json"
          Link="packaged-appsettings.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
